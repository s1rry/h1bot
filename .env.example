# --- обязательно ---
# Токен бота от @BotFather
BOT_TOKEN=
# Ваш Telegram ID от @userinfobot (бот отвечает только ему)
OWNER_TG_ID=
# Значение заголовка Cookie из my.h1cloud.net (см. README, раздел 2.3)
H1_COOKIE=

# --- опрос тикетов ---
POLL_SEC=10
POLL_FAST_SEC=4
NOTIFY_NEW=1
AUTO_DELAY_SEC=2

# --- ИИ-черновики (достаточно одного) ---
GEMINI_API_KEY=
# GEMINI_MODEL=   (по умолчанию gemini-3.8-flash)
TONWAVE_API_KEY=
# TONWAVE_MODEL=  (по умолчанию claude-haiku-4-5)
